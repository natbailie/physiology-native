# Copy to .env.local (gitignored) and fill in from the same Supabase project the web app uses.
# Without these the app runs local-only: progress on the device, no accounts, and no paywall —
# the same behaviour physiology-app has with no .env.local, and worth keeping working.
#
# EXPO_PUBLIC_ is Metro's equivalent of Vite's VITE_ prefix: every value is inlined into the
# bundle a learner downloads, so only publishable keys belong here. src/lib/env.ts is the one
# module that reads them, mirroring the web project's src/lib/env.ts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat's publishable key. Not used yet: buying digital goods in an iOS or Android app has
# to go through in-app purchase, which needs react-native-purchases — a native module, so a
# development build rather than Expo Go. Entitlement itself is read from Supabase, so an
# institutional seat or a web subscription already unlocks this app without it.
EXPO_PUBLIC_REVENUECAT_PUBLIC_KEY=

# The tutor's Gemini key is NOT here and must never be, for the reason the web project's
# .env.example gives at length: every EXPO_PUBLIC_ value ships to the device. It is a Supabase
# edge-function secret. Unlike the web app there is no local dev route either — see the note on
# isDev() in src/lib/env.ts — so the tutor needs the `chat` function deployed.
