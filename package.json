{
  "name": "physiology-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "sync": "node scripts/sync-engines.mjs",
    "sync:check": "node scripts/sync-engines.mjs --check",
    "verify": "npm run sync:check && npm run typecheck && npm run lint",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "expo": {
    "install": {
      "//": "eslint-config-expo is deliberately ahead of the version SDK 52 pins: only v57+ ships a flat config (eslint.config.js) and the react-hooks v6 rules, one of which caught a ref read during render in useNativeEngineLoop.ts. It is a lint-time-only dependency and never reaches the bundle.",
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "^5.3.0"
  }
}
